    VESSEL {
        bigint id PK
        char eni UK "8 jegy EU hajószám"
        char imo UK "nulla hajnal"
        int mmsi UK "AIS azonosito"
        string callsign
        bigint vessel_type_id FK
        bigint operator_id FK
        bigint home_port_id FK
        numeric length_m
        numeric beam_m
        numeric draught_max_m
        numeric deadweight_t
        int teu
        string status
        date valid_from
        date valid_to
    }

    POSITION {
        bigint vessel_id PK
        timestamptz ts PK
        geometry geom "Point 4326"
        numeric sog_mps
        numeric cog_deg
        numeric heading_deg
        string nav_status
        string source_kind "ais derived manual"
        bigint source_id FK
        numeric river_km "denormalizalt"
        int lat_e7
        int lon_e7
    }

    VOYAGE {
        bigint id PK
        bigint vessel_id FK
        bigint convoy_id FK
        bigint origin_port_id FK
        bigint dest_port_id FK
        string status
        timestamptz planned_departure
        timestamptz actual_departure
        timestamptz planned_arrival
        timestamptz actual_arrival
        string source
    }

    PORT {
        bigint id PK
        string code UK
        string unlocode UK
        string port_type
        bigint waterway_id FK
        string country_code FK
        numeric river_km
        geometry geom
    }

    LOCK {
        bigint id PK
        bigint port_id FK
        string code UK
        int chamber_count
        numeric chamber_length_m
        numeric chamber_width_m
        numeric max_draft_m
        bigint operator_id FK
        numeric avg_transit_min
    }

    CONVOY {
        bigint id PK
        bigint lead_vessel_id FK
        string convoy_type
        timestamptz formed_at
        timestamptz dissolved_at
        string status
    }

    CONVOY_MEMBER {
        bigint convoy_id PK
        bigint vessel_id PK
        string role "lead push barge towed"
        int position_in_unit
    }
